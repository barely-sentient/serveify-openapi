{
  "name": "serveify-openapi",
  "version": "1.0.3",
  "description": "Turn your openapi specification into an actual server",
  "keywords": [
    "serveify",
    "openapi",
    "server",
    "http"
  ],
  "homepage": "https://github.com/barely-sentient/serveify-openapi#readme",
  "bugs": {
    "url": "https://github.com/barely-sentient/serveify-openapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barely-sentient/serveify-openapi.git"
  },
  "license": "MIT",
  "author": "Barely Sentient",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --watch"
  },
  "dependencies": {
    "express": "^4.19.2",
    "json-ject": "^1.0.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
